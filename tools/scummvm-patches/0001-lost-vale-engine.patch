+bool Debugger::cmdFindShape(int argc, const char **argv) {
+	// Lost Vale: locate every live item of a given shape. Hunting a quest
+	// item by clicking pixels is unreliable -- a sprite smaller than the
+	// probe step, or one an adjacent floor tile sorts over, reads exactly
+	// like an item that was never created at all.
+	if (argc != 2) {
+		debugPrintf("usage: ObjectManager::findShape <shape>\n");
+		return true;
+	}
+	uint32 want = (uint32)atoi(argv[1]);
+	ObjectManager *om = ObjectManager::get_instance();
+	int found = 0;
+	for (uint32 id = 1; id < 65536; ++id) {
+		Item *item = dynamic_cast<Item *>(om->getObject((ObjId)id));
+		if (!item || item->getShape() != want)
+			continue;
+		if (found < 40) {
+			// Where it actually is on screen. Predicting that from world
+			// coordinates by hand is guesswork -- the camera offset drifts
+			// with the avatar's z -- and a 5x4 gem sprite falls straight
+			// through a probe grid built on a wrong guess.
+			int32 sx = -1, sy = -1;
+			GameMapGump *gmg = Ultima8Engine::get_instance()->getGameMapGump();
+			if (gmg)
+				gmg->GetLocationOfItem(item->getObjId(), sx, sy);
+			debugPrintf("%s px=(%d,%d)\n", item->dumpInfo().c_str(), sx, sy);
+		}
+		++found;
+	}
+	debugPrintf("findShape %u: %d found\n", want, found);
+	return true;
+}
+
+static int liveConversations() {
+	int n = 0;
+	for (const auto *p : Kernel::get_instance()->getProcesses()) {
+		if (!p || p->is_terminated())
+			continue;
+		if (!strcmp(p->GetClassType()._className, "UCProcess"))
+			++n;
+	}
+	return n;
+}
+
+bool Debugger::cmdAsk(int argc, const char **argv) {
+	// No argument lists the open question's options; one argument answers it.
+	// Clicking a dialogue option means first locating a row of text whose
+	// width and position depend on the answer strings, and a mis-hit reads
+	// exactly like a mis-read conversation tree.
+	Gump *desktop = Ultima8Engine::get_instance()->getDesktopGump();
+	AskGump *ask = desktop ? dynamic_cast<AskGump *>(desktop->FindGump<AskGump>(true)) : nullptr;
+	if (!ask) {
+		// convo>0 with no question means the NPC is mid-bark and another
+		// question is still coming. Without this a caller cannot tell that
+		// from a finished conversation, and has to guess with a timeout --
+		// which costs twenty seconds on every single turn.
+		debugPrintf("ask: no question open convo=%d\n", liveConversations());
+		return true;
+	}
+	Common::StringArray answers = ask->listAnswers();
+	if (argc < 2) {
+		for (uint i = 0; i < answers.size(); ++i)
+			debugPrintf("ask[%u]: %s\n", i, answers[i].c_str());
+		debugPrintf("ask: %u options convo=%d\n",
+		            (uint)answers.size(), liveConversations());
+		return true;
+	}
+	uint idx = (uint)atoi(argv[1]);
+	if (!ask->answerByIndex(idx)) {
+		debugPrintf("ask: no option %u (have %u)\n", idx, (uint)answers.size());
+		return true;
+	}
+	debugPrintf("ask: answered %u = %s\n", idx,
+	            idx < answers.size() ? answers[idx].c_str() : "?");
+	return false;
+}
+
+bool Debugger::cmdHoldActor(int argc, const char **argv) {
+	// Stop an NPC wandering. A loitering villager covers a few hundred
+	// world units while a teleport-and-probe sequence runs, so by the time
+	// the pointer arrives the reported screen position is stale and the
+	// double-click that would start the conversation lands on grass.
+	if (argc < 2 || argc > 4) {
+		debugPrintf("usage: Actor::hold <objid> [dx dy]\n");
+		return true;
+	}
+	ObjId id = (ObjId)atoi(argv[1]);
+	Actor *a = getActor(id);
+	if (!a) {
+		debugPrintf("hold: %u is not an actor\n", (uint)id);
+		return true;
+	}
+	Kernel *kernel = Kernel::get_instance();
+	kernel->killProcesses(id, 0x205, true);   // LoiterProcess (U8)
+	kernel->killProcesses(id, 599, true);     // LoiterProcess (Crusader)
+	kernel->killProcesses(id, PathfinderProcess::PATHFINDER_PROC_TYPE, true);
+
+	// Killing the walk is not enough on its own: SchedulerProcess hands the
+	// villager a fresh activity within seconds, so by the time a probe grid
+	// finishes she is walking again. Put her where she is wanted and report
+	// the pixel, so nothing has to be predicted between here and the click.
+	MainActor *av = getMainActor();
+	if (av) {
+		int dx = (argc > 2) ? atoi(argv[2]) : 88;
+		int dy = (argc > 3) ? atoi(argv[3]) : -88;
+		Point3 ap = av->getLocation();
+		a->move(ap.x + dx, ap.y + dy, ap.z);
+	}
+	Point3 p = a->getLocation();
+	int32 sx = -1, sy = -1;
+	GameMapGump *gmg = Ultima8Engine::get_instance()->getGameMapGump();
+	if (gmg)
+		gmg->GetLocationOfItem(id, sx, sy);
+	debugPrintf("hold: %u at (%d,%d,%d) px=(%d,%d)\n", (uint)id, p.x, p.y, p.z, sx, sy);
+	return true;
+}
+
+bool Debugger::cmdTalkTo(int argc, const char **argv) {
+	// Start a conversation with no pointer involved. A double-click on an
+	// NPC ends in callUsecodeEvent_use(); getting the pointer onto her
+	// sprite first is the part that keeps failing -- the camera stays
+	// parked where the last conversation ended, and a pixel measured
+	// against it lands off screen.
+	if (argc != 2) {
+		debugPrintf("usage: Actor::talk <objid>\n");
+		return true;
+	}
+	ObjId id = (ObjId)atoi(argv[1]);
+	Item *item = getItem(id);
+	if (!item) {
+		debugPrintf("talk: no item %u\n", (uint)id);
+		return true;
+	}
+	item->callUsecodeEvent_use();
+	debugPrintf("talk: use sent to %u\n", (uint)id);
+	return false;
+}
+
+bool Debugger::cmdGrabItem(int argc, const char **argv) {
+	// Put an item in the Avatar's pack without a pointer. This is the same
+	// destination a drag onto the Avatar reaches (GameMapGump::DraggingItem
+	// sends trace == kMainActorId to the backpack's CanAddItem); what it
+	// skips is finding the sprite first, which for a 5x4 gem lying on a
+	// floor tile is the part that fails.
+	if (argc != 2) {
+		debugPrintf("usage: Item::grab <objid>\n");
+		return true;
+	}
+	ObjId id = (ObjId)atoi(argv[1]);
+	Item *item = getItem(id);
+	if (!item) {
+		debugPrintf("grab: no item %u\n", (uint)id);
+		return true;
+	}
+	MainActor *av = getMainActor();
+	if (!av) {
+		debugPrintf("grab: no avatar\n");
+		return true;
+	}
+	Container *pack = getContainer(av->getEquip(ShapeInfo::SE_BACKPACK));
+	if (!pack) {
+		debugPrintf("grab: no backpack\n");
+		return true;
+	}
+	if (!pack->CanAddItem(item, true)) {
+		debugPrintf("grab: backpack will not take %u\n", (uint)id);
+		return true;
+	}
+	if (!item->moveToContainer(pack)) {
+		debugPrintf("grab: move failed for %u\n", (uint)id);
+		return true;
+	}
+	debugPrintf("grab: %u in pack\n", (uint)id);
+	return true;
+}
+
+bool Debugger::cmdSetQuantity(int argc, const char **argv) {
+	// Drain a stack, so a refill can be observed. Reagents are only spent
+	// by casting, which is a poor thing to drive from a test harness.
+	if (argc != 3) {
+		debugPrintf("usage: Item::setQuantity <objid> <n>\n");
+		return true;
+	}
+	Item *item = getItem((ObjId)atoi(argv[1]));
+	if (!item) {
+		debugPrintf("setQuantity: no item %s\n", argv[1]);
+		return true;
+	}
+	// Quantity IS quality for SF_QUANTITY/SF_REAGENT items -- that is what
+	// Item::I_setQuantity does, and reagents carry their count there while
+	// the frame carries their identity.
+	item->setQuality((uint16)atoi(argv[2]));
+	debugPrintf("setQuantity: %u now %u\n", (uint)item->getObjId(),
+	            (uint)item->getQuality());
+	return true;
+}
